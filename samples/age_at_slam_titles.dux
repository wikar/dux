// Average age at which players won Grand Slam titles, alongside their title count.
// Demonstrates: DEFINE MEASURE, VAR, AND keyword, SUMMARIZECOLUMNS with
// multiple aggregations.

DEFINE
    MEASURE matches[Avg Title Age] =
        AVERAGE(matches[winner_age])

EVALUATE
    VAR gs_finals = FILTER(
        matches,
        matches[round] = "F" AND matches[tourney_level] = "G"
    )
    RETURN SUMMARIZECOLUMNS(
        gs_finals[winner_name],
        "Titles",        COUNT(gs_finals[match_num]),
        "Avg Title Age", AVERAGE(gs_finals[winner_age])
    )
