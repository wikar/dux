// Grand Slam title counts per player.
// Uses a VAR to pre-filter to Grand Slam finals, then groups by winner.
// Demonstrates: VAR, AND keyword in a FILTER condition, SUMMARIZECOLUMNS.

EVALUATE
    VAR gs_finals = FILTER(
        matches,
        matches[round] = "F" AND matches[tourney_level] = "G"
    )
    RETURN SUMMARIZECOLUMNS(
        gs_finals[winner_name],
        "Titles", COUNT(gs_finals[match_num])
    )
