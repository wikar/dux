// Average discounted order value alongside order count by venue.
// The query-local measure sits next to the model's own OrderCount measure.
// Demonstrates: DEFINE MEASURE, SUMMARIZECOLUMNS with a filter argument.

DEFINE
    MEASURE Sales[Avg Order Value] =
        AVERAGE(Sales[_NetSalesAmount])

EVALUATE
    SUMMARIZECOLUMNS(
        Venue[Venue],
        FILTER(Sales, Sales[_DiscountRate] > 0),
        "Orders",          Sales[OrderCount],
        "Avg Order Value", Sales[Avg Order Value]
    )
