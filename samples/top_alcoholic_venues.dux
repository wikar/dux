// Top 10 venues by alcoholic-beverage revenue.
// Aggregates with a category filter, then ranks with TOPN.
// Demonstrates: VAR, TREATAS, SUMMARIZECOLUMNS, TOPN.

EVALUATE
    VAR venue_revenue = SUMMARIZECOLUMNS(
        Venue[Venue],
        TREATAS({"Alcoholic Beverages"}, Product[Category]),
        "Revenue", SUM(Sales[NetRevenue])
    )
    RETURN TOPN(10, venue_revenue, venue_revenue[Revenue])
