// Top 10 players by total match wins on clay.
// Chains two VARs: filter → aggregate → rank with TOPN.
// Demonstrates: chained VARs, SUMMARIZECOLUMNS on a VAR table, TOPN.

EVALUATE
    VAR clay = FILTER(
        matches,
        matches[surface] = "Clay"
    )
    VAR clay_wins = SUMMARIZECOLUMNS(
        clay[winner_name],
        "Wins", COUNT(clay[match_num])
    )
    RETURN TOPN(10, clay_wins, clay_wins[Wins])
